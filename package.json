{
  "name": "patch-roulette",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"vite dev\" \"wrangler dev --config wrangler.dev.jsonc\"",
    "dev:worker": "wrangler dev --config wrangler.dev.jsonc",
    "build": "vite build",
    "preview": "bun run build && wrangler dev --config wrangler.jsonc",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check-native --tsconfig ./tsconfig.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "db:generate": "drizzle-kit generate",
    "db:reset": "rm -rf .wrangler/state && echo 'Local Durable Object state reset.'",
    "deploy": "bun run build && wrangler deploy --config wrangler.jsonc",
    "test": "bun run build && vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/valibot-validator": "^0.6.1",
    "@tanstack/svelte-query": "^6.1.38",
    "@tanstack/svelte-table": "^9.1.2",
    "bcryptjs": "^3.0.3",
    "bits-ui": "^2.19.0",
    "drizzle-orm": "rc",
    "echarts": "^6.1.0",
    "hono": "^4.13.1",
    "kumo-svelte": "^0.12.0",
    "phosphor-svelte": "^3.1.0",
    "runed": "^0.37.1",
    "svelte-toolbelt": "^0.10.6",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.5",
    "drizzle-kit": "rc",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "svelte": "^5.56.10",
    "svelte-check-native": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  }
}
